# Токен бота от @BotFather (вида 123456789:AA...)
BOT_TOKEN=

# Необязательный резерв: id владельца и @username без @.
# Обычно бот сам узнаёт их из business_connection при подключении и хранит в SQLite.
OWNER_ID=

OWNER_USERNAME=

# Путь к базе архива
DB_PATH=data/archive.db

# Уведомления в личку: 1 — включены, 0 — выключены
NOTIFY=1

# Скачивать медиафайлы: 1 — скачивать в MEDIA_DIR, 0 — только метаданные
DOWNLOAD_MEDIA=0

# Каталог для скачанных медиафайлов
MEDIA_DIR=data/media

# chat_id, которые нужно игнорировать, через запятую (пусто — не игнорировать)
IGNORE_CHATS=

# Хранить сообщения N дней; 0 — хранить всё
RETENTION_DAYS=0

# Часовая зона для уведомлений (zoneinfo)
TZ=Europe/Moscow

# Уровень логирования: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
